# ========================================================
# GREEN APPLE CATERING & EVENT COMPANY — ENVIRONMENT CONFIG
# ========================================================

# 1. MongoDB Database
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.mongodb.net/green_apple?retryWrites=true&w=majority
MONGODB_DB=green_apple

# 2. Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# 3. Admin Authentication
ADMIN_JWT_SECRET=green-apple-catering-jwt-secret-2026-production-ready
ADMIN_EMAIL=admin@greenapplecatering.in
ADMIN_INITIAL_PASSWORD=GreenAppleAdmin@2026!
